rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{code} {
      function signedIn() { return request.auth != null; }
      function isMember() {
        return exists(/databases/$(database)/documents/classes/$(code)/members/$(request.auth.uid));
      }
      function isHost() {
        return get(/databases/$(database)/documents/classes/$(code)).data.createdBy == request.auth.uid;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if signedIn() && isMember();
        allow create, update: if signedIn() && request.auth.uid == memberId;
        allow delete: if signedIn() && (request.auth.uid == memberId || isHost());
      }

      match /entries/{entryId} {
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
                      && request.resource.data.authorID == request.auth.uid;
        allow update, delete: if signedIn() && isMember()
                              && (resource.data.authorID == request.auth.uid || isHost());
      }
    }
  }
}
